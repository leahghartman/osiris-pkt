! ----- Simulation parameters -----
simulation{
    omega_p0 = 1.0,
    algorithm = "pkt",
}

! ----- Node Configuration -----
node_conf{
    node_number(1) = 1,
    if_periodic(1) = .false.,
}

! ----- Spatial grid -----
grid{
    nx_p(1) = 100,
    coordinates = "cartesian",
}

! ----- Time step -----
time_step{
    dt = 0.01,
    ndump = 1,
}

! ----- Space settings -----
space{
    xmin(1) = 0.0,
    xmax(1) = 10.0,
    if_move(1) = .true.,
}

! ----- Time settings -----
time{
    tmin = 0.0,
    tmax = 10.0,
}

! ----- EM Boundaries -----
emf_bound{
    type(1:2,1) = "open","open",
}

! ----- PKT settings -----
particles{
    num_pkt = 1,
    interpolation = "quadratic",
}

pkt_group{
    if_damp_classical = .false.,
    if_damp_pkt = .false.,
    if_pairprod = .false.,
}

species{
    name = "electrons",
    num_par_max = 1000,
    num_par_x = 100,
    !num_par_x(1) = 1,
    rqm = -1.0,
    q_real = -1.0,
    add_tag = .false.,
    free_stream = .false.,
    push_type = "standard",
}

udist{
    ufl(1:3) = 0.0, 0.0, 0.0,
}

profile{
    density = 1.0,
    profile_type(1) = "math func",
    math_func_expr = "1.0 / (1.0 + exp(-(x1-3.0)/0.4)) - 1.0 / (1.0 + exp(-(x1-7.0)/0.4))",
}

!profile{
    !density = 1.0,
    !profile_type(1) = "math func",
    !math_func_expr = "max(0.0, min(1.0, (x1-3.0)/(7.0-3.0)))",
!}

spe_bound{
    type(1:2,1) = "open","open",
}

diag_species{
    ndump_fac = 1,
    reports = "charge",
}

species{
    name = "photons",
    num_par_max = 5000,
    !num_par_x = 1,
    num_par_x = 100,
    add_tag = .true.,
}

udist{
    ufl(1) = 3,
    uth(1) = 0.0005,
    uth(2:3) = 0.0, 0.0,
}

profile{
    density = 1.0,
    profile_type = "math func",
    math_func_expr = "exp(-((x1-1.5)/0.2)^2)", !"if(x1<=0.2,if(x1>0,1,0),0)",
}

spe_bound{
    type(1:2,1) = "open","open",
}

diag_species {
    ndump_fac_raw = 1,
}
