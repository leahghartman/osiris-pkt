! --- Simulation Configuration ---
simulation {
  omega_p0 = 1.0,
  algorithm = "pkt",
}

! --- Node Configuration ---
node_conf {
  node_number(1) = 1,
  if_periodic(1) = .false.,
}

! --- Grid/Time Step Configuration ---
grid {
  nx_p(1:1) = 401,
  coordinates = "cartesian",
}

time_step {
  dt = 0.0379939,
  ndump = 2120,
}

! --- Total Space/Time Configuration ---
space {
  xmin = -14.7507598784,
  xmax = 0.5,
  if_move(1:1) = .true.,
}

time {
  tmin = 0.0d0,
  tmax  = 25000.0,
}

! --- EMF Boundary Configuration ---
emf_bound {
  type(1:2,1) = "open","open",
}

! --- Particle Configuration ---
particles {
  num_species = 1,
  num_pkt = 1,
  interpolation = "quadratic",
}

! -------------------------------------------
! --- ELECTRONS/BACKGROUND PLASMA PROFILE ---
! -------------------------------------------
species {
  name = "plasma",
  num_par_max = 500000,
  num_par_x(1:1) = 50,
  rqm = -1.0,
  push_type = "std_photon_feedback",
  !push_type = "standard",
}

udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
  ufl(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
}

profile {
  profile_type(1:1) = "math func",
  math_func_expr = "if(x1<=30,0,if(x1<= 31, 1.0/1.0*(x1-30.0),0.25606118 + 1.60849277 / pow(83.93604422 + (x1 - 31),0.17251488) ))",
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species { 
  ndump_fac = 1,
  ndump_fac_pha =  1,
  ndump_fac_ene = 1,
  ps_xmin(1:1) = -30.0,   
  ps_xmax(1:1) = 0.5,
  ps_nx(1:1)   = 500,
  
  ps_pmin(1:3)   = -1.5e0, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.5e0,  1.e-5, 1.e-5,
  ps_np(1:3)     =  200,  100, 100,
  reports = "charge","ene",
}

! ----------------------
! --- PHOTON PROFILE ---
! ----------------------
species {
  name = "photons",
  num_par_max = 500000,
  num_par_x(1:1) = 50,
  add_tag = .true.,
}

udist {
  use_classical_uadd = .true.,
  ufl(1) = 10.0,
  uth(1) = 1.41421356,
  uth(2:3) = 0.0, 0.0,
}

profile {
  profile_type = "math func",
  math_func_expr = "exp(-4*(x1 + 5.52537)^2/(1.0)^2)",
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species {
  ndump_fac = 1,
  ndump_fac_raw = 1,
  reports = "charge","ene",
}

! -------------------------------
! --- ELECTRON DRIVER PROFILE ---
! -------------------------------
species {
  name = "driver",
  num_par_max = 500000,
  num_par_x(1:1) = 50,
  rqm = -1.0,
}

udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0 , 0.00 , 0.0d0 ,
  ufl(1:3) = 100000.0d0 , 0.00 , 0.0d0 ,
  n_accelerate = 700,  !40000,
  n_q_incr = 350,
  n_accelerate_type = "regressive",
  n_q_incr_type = "linear",
}

profile {
  profile_type(1:1) = "math func",
  math_func_expr = "if(-x1 >= 1.0,0,if(x1<= 0, 0.8, 0))", !driver profile
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species { 
  ndump_fac = 1,
  ndump_fac_pha =  1,
  ndump_fac_ene = 1,
  ps_xmin(1:1) = -30.0,
  ps_xmax(1:1) = 0.5d0,
  ps_nx(1:1)   = 500,
  ps_pmin(1:3)   = 0, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.1e5,  1.e-5, 1.e-5,
  ps_np(1:3)     =  500,  100, 100,
  reports = "charge","ene","j1","j2","j3",
  phasespaces = "p1x1",
}
