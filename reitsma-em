! --- Simulation Configuration ---
simulation {
    omega_p0 = 1.0,
}

! --- Node Configuration ---
node_conf {
  node_number(1) = 1,
  if_periodic(1) = .false.,
}

! --- Grid/Time Step Configuration ---
grid {
  nx_p(1:1) = 10000,
  coordinates = "cartesian",
}

time_step {
  dt = 0.001,
  ndump = 21200,
}

! --- Total Space/Time Configuration ---
space {
  xmin = -65.0,
  xmax = 0.0,
  if_move(1:1) = .true.,
}

time {
  tmin = 0.0d0,
  tmax  = 5000.0,
}

! --- EMF Boundary Configuration ---
el_mag_fld {
    solver = "yee",
}

emf_bound {
  type(1:2,1) = "open","open",
}

diag_emf {
  ndump_fac = 1,
  prec = 4,
  ndump_fac_ene_int = 1,
  reports = "e1","e2","e3","b1","b2","b3","ene_e2","ene_b"
}

! --- Particle Configuration ---
particles {
  num_species = 1,
  interpolation = "quadratic",
}

! -------------------------------------------
! --- ELECTRONS/BACKGROUND PLASMA PROFILE ---
! -------------------------------------------
species {
  name = "plasma",
  num_par_max = 500000,
  num_par_x(1:1) = 4,
  rqm = -1.0,
}

udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
  ufl(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
}

profile {
  profile_type(1) = "uniform",
  density = 1.0,
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species { 
  ndump_fac = 1,
  ndump_fac_ene = 1,
  reports = "charge","ene",
}

! ----------------------
! --- ZPULSE PROFILE ---
! ----------------------
zpulse { 
  a0 = 1.0,
  omega0 = 20.0,    
  pol_type = 1,
  chirp_order = 1,
  chirp_coefs = 0,
  propagation = "forward",
  lon_type = "gaussian",
  lon_x0 = -30.0,
  lon_duration = 22.627,
  lon_range = 60.0,
  per_type = "gaussian",
  per_w0 = 200.00d0,
  per_focus = 30.d0,
  per_center = 0.0,
}
