! ===============================
! ==   AWAKE-like Simulation   ==
! ==   (matched to Sandberg & Thomas PRL 130, 085001 (2023) Sim. A     ==
! ==    parameters: nd0/np0=0.8, kp0*Ld=1.0, omega0/omegap0=5,        ==
! ==    with the driver swapped for a 400 GeV proton beam)            ==
! ==   GEOMETRY: driver placed near box leading edge, plasma pushed   ==
! ==   ~45 units ahead to give runway for n_accelerate/n_q_incr       ==
! ==   to complete in vacuum before the driver reaches the plasma     ==
! ===============================
! --- Simulation Configuration ---
simulation {
  n0 = 7e19,          ! Reference plasma density [cm^-3]
  algorithm = "pkt",  ! Photon kinetic algorithm
}
! --- Node Configuration ---
node_conf {
  node_number(1) = 1,
  if_periodic(1) = .false.,
}
! --- Grid/Time Step Configuration ---
grid {
  nx_p(1:1) = 400,
  coordinates = "cartesian",
}
time_step {
  dt = 0.06125,
  ndump = 103,
}
! --- Total Space/Time Configuration ---
space {
  xmin = 0.0,
  xmax = 25.5,
  if_move(1:1) = .true.,
}
time {
  tmin = 0.0d0,
  tmax  = 205000,
}
! --- EMF Boundary Configuration ---
emf_bound {
  type(1:2,1) = "open","open",
}
diag_emf {
  ndump_fac = 1,
  prec = 4,
  ndump_fac_ene_int = 1,
  reports = "e1","e2","e3","b1","b2","b3","ene_e2","ene_b"
}
! --- Particle Configuration ---
particles {
  num_species = 1,
  num_pkt = 1,
  interpolation = "quadratic",
}
! -------------------------------------------
! --- ELECTRONS/BACKGROUND PLASMA PROFILE ---
! -------------------------------------------
species {
  name = "plasma",
  num_par_max = 200000,
  num_par_x(1:1) = 16,
  rqm = -1.0,
  push_type = "std_photon_feedback",
}
udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
  ufl(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
}
profile {
  profile_type(1:1) = "math func",
  math_func_expr = "if(x1<=70.0, 0.0, if(x1<=71.0, 1.0*(x1-70.0), 0.253861 + 1.130011 / pow(18.696280 + (x1 - 88.0), 0.141433)))",
}
spe_bound {
  type(1:2,1) = "open","open",
}
diag_species {
  ndump_fac = 1,
  ndump_fac_pha = 1,
  ndump_fac_ene = 1,
  ps_xmin(1:1) = 0.0,
  ps_xmax(1:1) = 25.5,
  ps_nx(1:1)   = 400,
  ps_pmin(1:3)   = -1.5e0, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.5e0,  1.e-5, 1.e-5,
  ps_np(1:3)     =  200,  100, 100,
  reports = "charge","ene",
}
! ----------------------
! --- PHOTON PROFILE ---
! ----------------------
species {
  name = "photons",
  num_par_max = 200000,
  num_par_x(1:1) = 16,
  add_tag = .true.,
}
udist {
  use_classical_uadd = .true.,
  ufl(1) = 4.898979,
  uth(1) = 0.3536,
  uth(2:3) = 0.0, 0.0,
}
profile {
  density = 0.005,
  profile_type(1) = "gaussian",
  gauss_center(1) = 19.6858,
  gauss_sigma(1) = 0.3536,
  gauss_range(1:2,1) = 18.2758, 21.0958,
}
spe_bound {
  type(1:2,1) = "open","open",
}
diag_species {
  ndump_fac = 1,
  ndump_fac_raw = 1,
  reports = "charge","ene",
}
! -----------------------------
! --- PROTON DRIVER PROFILE ---
! -----------------------------
species {
  name = "driver",
  num_par_max = 200000,
  num_par_x(1:1) = 16,
  rqm = 1836.15,
}
udist {
  use_classical_uadd = .true.,
  ufl(1:3) = 426.31, 0.0d0, 0.0d0,
  uth(1:3) = 0.0d0, 0.0d0, 0.0d0,
  n_accelerate = 700,
  n_q_incr = 350,
  n_accelerate_type = "regressive",
  n_q_incr_type = "linear",
}
profile {
  profile_type(1:1) = "math func",
  math_func_expr = "if(x1>25.0, 0, if(x1<24.0, 0, 0.9))",
}
spe_bound {
  type(1:2,1) = "open","open",
}
diag_species {
  ndump_fac = 1,
  ndump_fac_raw = 1,
  ndump_fac_pha = 1,
  ndump_fac_ene = 1,
  ps_xmin(1:1) = 0.0,
  ps_xmax(1:1) = 25.5,
  ps_nx(1:1)   = 400,
  ps_pmin(1:3)   = 0, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.1e5,  1.e-5, 1.e-5,
  ps_np(1:3)     =  500,  100, 100,
  reports = "charge","ene","j1","j2","j3",
  phasespaces = "p1x1",
}
