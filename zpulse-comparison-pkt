! --- Simulation Configuration ---
simulation {
  n0 = 3.6e19,
  algorithm = "pkt",
}

! --- Node Configuration ---
node_conf {
  node_number(1) = 1,
  if_periodic(1) = .false.,
}

! --- Grid/Time Step Configuration ---
grid {
  nx_p(1:1) = 10000,
  coordinates = "cartesian",
}

time_step {
  dt = 0.005,
  ndump = 4240,
}

! --- Total Space/Time Configuration ---
space {
  xmin = 50,
  xmax = 108,
  if_move(1:1) = .true.,
}

time {
  tmin = 0.0d0,
  tmax  = 5000.0,
}

! --- EMF Boundary Configuration ---
emf_bound {
  type(1:2,1) = "open","open",
}

diag_emf {
  ndump_fac = 1,
  prec = 4,
  ndump_fac_ene_int = 1,
  reports = "e1","e2","e3","b1","b2","b3","ene_e2","ene_b"
}


! --- Particle Configuration ---
particles {
  num_species = 0,
  num_pkt = 1,
  interpolation = "quadratic",
}

! -------------------------------------------
! --- ELECTRONS/BACKGROUND PLASMA PROFILE ---
! -------------------------------------------
species {
  name = "plasma",
  num_par_max = 500000,
  num_par_x(1:1) = 4,
  rqm = -1.0,
  push_type = "std_photon_feedback",
  !push_type = "standard",
}

udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
  ufl(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
}

profile {
  profile_type(1) = "uniform",
  density = 1.0,
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species { 
  ndump_fac = 1,
  ndump_fac_pha =  1,
  ndump_fac_ene = 1,
  ps_xmin(1:1) = -30.0,   
  ps_xmax(1:1) = 0.5,
  ps_nx(1:1)   = 500,
  
  ps_pmin(1:3)   = -1.5e0, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.5e0,  1.e-5, 1.e-5,
  ps_np(1:3)     =  200,  100, 100,
  reports = "charge","ene",
}

! ----------------------
! --- PHOTON PROFILE ---
! ----------------------
species {
  name = "photons",
  num_par_max = 500000,
  num_par_x(1:1) = 4,
  add_tag = .true.,
}

udist {
  use_classical_uadd = .true.,
  ufl(1) = 6.928,
  uth(1) = 0.246,
  uth(2:3) = 0.0, 0.0,
}

profile {
  density = 0.32,
  profile_type(1) = "gaussian",
  gauss_center(1) = 91.0,
  gauss_sigma(1) = 2.030,
  gauss_range(1:2,1) = 73.0, 107.0,
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species {
  ndump_fac = 1,
  ndump_fac_raw = 1,
  reports = "charge","ene",
}
