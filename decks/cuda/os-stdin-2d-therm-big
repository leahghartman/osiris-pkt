simulation
{
  algorithm = "cuda",
}

!----------the node configuration for this simulation---------
node_conf
{
  node_number(1:2) = 1,1,
  n_threads = 1,
  tile_number(1:2) = 144,144,
  if_periodic(1:2) = .true., .true.,
  tile_topology = "snake",
  chunk_size = 5120,
  chunk_pool_size = 100000,
  nchunks_pad = 8,
}

!----------spatial grid----------
grid
{
  nx_p(1:2) = 1152, 1152,
  coordinates = "cartesian",
  ! load_balance(1:2) = .true., .true.,
  ! lb_type = "dynamic",
  ! n_dynamic = 20,
  ! cell_weight = 1.0,
  ! ndump_tile_load = 100,
  ! ndump_node_load = 100,
  ! ndump_global_load = 10,
  ! ndump_tile_node = 100,
  ! ndump_grid_load = 100,
}

!----------time step and global data dump timestep number----------
time_step
{
  dt = .098,
  ndump  = 0,
}

!----------restart information----------
restart
{
}

!----------spatial limits of the simulations----------
!(note that this includes information about
! the motion of the simulation box)
space
{
  xmin(1:2) = 0, 0,
  xmax(1:2) = 159.9993, 159.9993,
  if_move = .false., .false.,
}


!----------time limits ----------
time
{
  tmin = 0.0,
  tmax = .98,
}

el_mag_fld
{
  ! ext_fld = "static",
  ! ext_b0(1:3)=0.0d0,0.0d0,0.0d0,
  ! ext_e0(1:3)=1.0d0,1.0d0,0.0d0,
}

!----------boundary conditions for em-fields ----------
emf_bound
{
}

!----------diagnostic for electromagnetic fields----------
diag_emf
{
  ndump_fac = 1,
  reports = "e1", "e2",
}

!----------number of particle species----------
particles
{
  num_species = 1,
  interpolation =  "linear",
}

!----------electrons----------
species
{
  name = "electrons",
  num_par_max = 30000,
  rqm=-1.0,
  num_par_x(1:2) = 20,20,
  n_sort = 0,
  ! free_stream = .true.,
  push_type = "standard",
}

udist
{
  uth(1:3) = 0.1 , 0.1 , 0.1,
  ufl(1:3) = 0.0 , 0.0 , 0.0,
}

profile
{
  density = 1,
  profile_type = "uniform",
}

spe_bound
{
}

diag_species
{
  ndump_fac = 1,
  reports = "charge", "j1", "j2",
}

current{}

diag_current
{
  ndump_fac = 1,
  reports = "j1", "j2", "j3",
}
smooth
{
}

