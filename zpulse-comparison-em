! --- Simulation Configuration ---
simulation {
    n0 = 3.6e19,
}

node_conf {
  node_number(1:1) = 1,
  if_periodic(1:1) = .false.,
}

grid {
  nx_p(1:1) = 50000,
  coordinates = "cartesian",
}

time_step {
  dt = 0.0002,
  ndump = 106000,
}

space {
  xmin = 50.0,
  xmax = 108.0,
  if_move(1:1) = .true.,
}

time {
  tmin = 0.0d0,
  tmax  = 5000.0,
}

el_mag_fld {
  solver = "yee",
}

emf_bound {
  type(1:2,1) = "open","open",
}

diag_emf {
  ndump_fac = 1,
  prec = 4,
  ndump_fac_ene_int = 1,
  reports = "e1","e2","e3","b1","b2","b3","ene_e2","ene_b"
}

particles {
  num_species = 1,
  interpolation = 'quadratic',
}

species {
  name = "plasma",
  num_par_max = 500000,
  num_par_x(1:1) = 4,
  rqm = -1.0,
}

udist {
  uth(1:3) = 0.0d0 , 0.00 , 0.0d0 ,
  ufl(1:3) = 0.0d0 , 0.0d0 , 0.0d0 ,
}

profile {
  profile_type(1:1) = "uniform",
  density = 1.0,
}

spe_bound {
  type(1:2,1) = "open","open",
}

diag_species { 
  ndump_fac = 1,
  ndump_fac_pha =  1,
  ndump_fac_ene = 1,
  ps_xmin(1:1) = 50.0,   
  ps_xmax(1:1) = 108.0,
  ps_nx(1:1)   = 500,
  
  ps_pmin(1:3)   = -1.5e0, -1.e-5, -1.e-5,
  ps_pmax(1:3)   =  1.5e0,  1.e-5, 1.e-5,
  ps_np(1:3)     =  200,  100, 100,
  reports = "charge","ene",
}

zpulse { 
  a0 = 0.8,
  omega0 = 7.0,            
  pol = 0.0d0,
  chirp_order = 1,
  chirp_coefs = 0,
  propagation = "forward",
  lon_type = "gaussian",
  lon_x0 = 91.0,
  lon_duration = 5.74,
  lon_range = 36.0,
  per_type = "gaussian",
  per_w0 = 200.00d0,
  per_focus = 30.d0,
  per_center = 0.0,
}

diag_current {
  ndump_fac = 1,
  prec = 8,
  reports = "j1","j2","j3",
}
